# Server Configuration
PORT=3000
NODE_ENV=development

# Database (Prisma)
# Use "file:./dev.db" for local SQLite
# Use "postgresql://postgres:postgres@localhost:5432/ecommerce?schema=public" for Docker Postgres
DATABASE_URL="file:./dev.db"

# Redis (Caching & Queues)
REDIS_URL="redis://localhost:6379"

# Authentication (JWT)
# Minimum 32 characters recommended for production
JWT_SECRET=your_32_character_long_secret_key_here

# Payment Gateways (Secret Keys)
# Keep these server-side ONLY. Do NOT prefix with VITE_
ZALOPAY_KEY=
VNPAY_KEY=
MOMO_KEY=

# Logistics (Provider Tokens)
# Keep these server-side ONLY.
GHN_TOKEN=
GHTK_TOKEN=

# Public Client-side Variables (Exposed to browser)
# Prefix with NEXT_PUBLIC_ for client accessibility
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_APP_NAME="Hai Tụi Mình Store"

