# Server Configuration
PORT=3000
NODE_ENV=development

# Database (Prisma)
# Docker Postgres local database
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/ecommerce?schema=public"

# Redis (Caching & Queues)
REDIS_URL="redis://localhost:6379"

# Authentication (JWT)
# Minimum 32 characters recommended for production
JWT_SECRET=your_32_character_long_secret_key_here

# Payment Gateways (Secret Keys)
# Keep these server-side ONLY. Do NOT prefix with VITE_
ZALOPAY_KEY=
VNPAY_KEY=
MOMO_KEY=

# Logistics (Provider Tokens)
# Keep these server-side ONLY.
GHN_TOKEN=
GHTK_TOKEN=
VIETTELPOST_TOKEN=
VIETTELPOST_TRACKING_URL=
SPX_TRACKING_URL=
SPX_TOKEN=
AFTERSHIP_API_KEY=
AFTERSHIP_BASE_URL=https://api.aftership.com
AFTERSHIP_GHN_SLUG=ghn
AFTERSHIP_GHTK_SLUG=ghtk
AFTERSHIP_VIETTELPOST_SLUG=viettelpost
AFTERSHIP_SPX_SLUG=spx-vn

# Realtime GPS tracking via Traccar
# Keep these server-side ONLY. Use either TRACCAR_TOKEN or TRACCAR_EMAIL/TRACCAR_PASSWORD.
TRACCAR_BASE_URL=https://your-traccar.example.com
TRACCAR_TOKEN=
TRACCAR_EMAIL=
TRACCAR_PASSWORD=
# Optional fallback courier device when an order has no bound Traccar device.
TRACCAR_DEFAULT_DEVICE_ID=
TRACCAR_DEFAULT_UNIQUE_ID=

# Admin AI image generation (optional)
# Production should use OPENAI_API_KEY for real GPT image generation.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-4.1-mini
# Local fallback: defaults to ~/.codex/skills/codex-imagen/scripts/codex-imagen.mjs
CODEX_IMAGEN_SCRIPT_PATH=

# Public Client-side Variables (Exposed to browser)
# Prefix with VITE_ for Vite client accessibility
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_APP_NAME="Hai Tụi Mình Store"
VITE_BANK_NAME=
VITE_BANK_CODE=
VITE_BANK_ACCOUNT_NUMBER=
VITE_BANK_ACCOUNT_HOLDER=


# Claude prompt refinement for admin marketing (Claude does not generate bitmap images directly)
# Use ANTHROPIC_API_KEYS for comma/newline-separated key rotation in production.
ANTHROPIC_API_KEY=""
ANTHROPIC_API_KEYS=""
ANTHROPIC_MODEL="claude-opus-4-8"
ANTHROPIC_VERSION="2023-06-01"
